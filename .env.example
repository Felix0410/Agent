# 复制到仓库根目录 .env 后填写；后端自动读取，修改后重启后端。
# 同名进程环境变量（export / PyCharm）优先于 .env。
APP_ENV=development
LOG_LEVEL=INFO
# Agent 需支持 Tool Calling 的提供方；真实密钥只填入 .env，勿提交。
MODEL_NAME=
MODEL_API_KEY=
# 填 API 基础地址（通常以 /v1 结尾），不要包含 /chat/completions。
MODEL_BASE_URL=
# 数据库路径：相对路径以 backend 为基准；业务与检查点必须使用不同文件。
RUNTIME_DB_PATH=data/runtime.sqlite3
CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
# A 只读取配置；后台执行与排队在 P02-B 实现。
RUN_MAX_CONCURRENCY=2
RUN_QUEUE_SIZE=8
WORKSPACE_ROOT_PATH=data/workspaces
